<Project Sdk="Microsoft.NET.Sdk">
  <!-- Android head. Phones: android-arm64; emulator: android-x64. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Plural.App.Android</RootNamespace>
    <ApplicationId>net.getplural.app</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <AndroidResource Include="Icon.png">
      <Link>Resources\drawable\Icon.png</Link>
    </AndroidResource>
  </ItemGroup>

  <!-- CELT 0.7.1, built by Native/celt/build-android.sh -->
  <ItemGroup>
    <AndroidNativeLibrary Include="..\..\Native\celt\runtimes\android-arm64\native\libcelt071.so" Abi="arm64-v8a" />
    <AndroidNativeLibrary Include="..\..\Native\celt\runtimes\android-x64\native\libcelt071.so" Abi="x86_64" />
  </ItemGroup>

  <!-- LAME (MP3), built into Native/lame; optional until present. -->
  <ItemGroup>
    <AndroidNativeLibrary Include="..\..\Native\lame\runtimes\android-arm64\native\libmp3lame.so" Abi="arm64-v8a"
                          Condition="Exists('..\..\Native\lame\runtimes\android-arm64\native\libmp3lame.so')" />
    <AndroidNativeLibrary Include="..\..\Native\lame\runtimes\android-x64\native\libmp3lame.so" Abi="x86_64"
                          Condition="Exists('..\..\Native\lame\runtimes\android-x64\native\libmp3lame.so')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="12.1.4" />
    <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.0.1.15" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Plural.App\Plural.App.csproj" />
    <ProjectReference Include="..\Plural.Platform.Android\Plural.Platform.Android.csproj" />
  </ItemGroup>
</Project>
