<Project Sdk="Microsoft.NET.Sdk">
  <!-- Renders the real UI headless against simulated mics and writes store screenshots to Marketing/screenshots/.
       Run from Src/: dotnet run (project Plural.Screenshots, Release); see Marketing/README.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="12.1.4" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Plural.App\Plural.App.csproj" />
  </ItemGroup>

  <!-- A real SmartMike+ session (handshake, reports, QCELT audio), replayed by the simulated mics. -->
  <ItemGroup>
    <None Include="..\Plural.Core.Tests\TestData\record_6s_rx.bin" Link="TestData\record_6s_rx.bin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
