<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Plural.App.App"
             xmlns:local="using:Plural.App"
             xmlns:vm="using:Plural.App.ViewModels"
             xmlns:c="using:Plural.App.Controls"
             Name="Plural"
             RequestedThemeVariant="Default">
    <!-- "Default" follows the system light/dark setting. -->

    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="About Plural" Click="OnAboutMenuClick" />
        </NativeMenu>
    </NativeMenu.Menu>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="BgBrush" Color="#0D0F14" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#161A22" />
                    <SolidColorBrush x:Key="Surface2Brush" Color="#1F2430" />
                    <SolidColorBrush x:Key="StrokeBrush" Color="#2B3140" />
                    <SolidColorBrush x:Key="MutedBrush" Color="#8E97AB" />
                    <SolidColorBrush x:Key="AccentSoftBrush" Color="#264C8DFF" />
                    <SolidColorBrush x:Key="MeterTrackBrush" Color="#262C3A" />
                    <SolidColorBrush x:Key="ScrimBrush" Color="#B0000000" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#4C8DFF" />
                    <SolidColorBrush x:Key="PillLiveBrush" Color="#2235D07F" />
                    <SolidColorBrush x:Key="PillBusyBrush" Color="#26F5B53D" />
                    <SolidColorBrush x:Key="PillLostBrush" Color="#26FF5A5F" />
                    <SolidColorBrush x:Key="PillOffBrush" Color="#2A8E97AB" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="BgBrush" Color="#F2F4F8" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="Surface2Brush" Color="#EDF0F6" />
                    <SolidColorBrush x:Key="StrokeBrush" Color="#DDE2EC" />
                    <SolidColorBrush x:Key="MutedBrush" Color="#667085" />
                    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1F2F6FE0" />
                    <SolidColorBrush x:Key="MeterTrackBrush" Color="#E2E6EF" />
                    <SolidColorBrush x:Key="ScrimBrush" Color="#80000000" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#2F6FE0" />
                    <SolidColorBrush x:Key="PillLiveBrush" Color="#2427B068" />
                    <SolidColorBrush x:Key="PillBusyBrush" Color="#33E0A020" />
                    <SolidColorBrush x:Key="PillLostBrush" Color="#26E5484D" />
                    <SolidColorBrush x:Key="PillOffBrush" Color="#1F667085" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <SolidColorBrush x:Key="RecordBrush" Color="#FF4D5E" />
            <SolidColorBrush x:Key="LiveBrush" Color="#2FCF7A" />
            <SolidColorBrush x:Key="WarnBrush" Color="#F5B53D" />
            <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />

            <CornerRadius x:Key="RadiusCard">16</CornerRadius>
            <CornerRadius x:Key="RadiusControl">12</CornerRadius>
            <x:Double x:Key="TouchSize">44</x:Double>

            <!-- Icons: Material Design glyphs (24x24), drawn as Path with Stretch=Uniform -->
            <StreamGeometry x:Key="IconMic">M12 14c1.66 0 3-1.34 3-3V5c0-1.66-1.34-3-3-3S9 3.34 9 5v6c0 1.66 1.34 3 3 3zm5.3-3c0 3-2.54 5.1-5.3 5.1S6.7 14 6.7 11H5c0 3.41 2.72 6.23 6 6.72V21h2v-3.28c3.28-.48 6-3.3 6-6.72h-1.7z</StreamGeometry>
            <StreamGeometry x:Key="IconRefresh">M17.65 6.35A7.958 7.958 0 0 0 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0 1 12 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z</StreamGeometry>
            <StreamGeometry x:Key="IconLink">M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z</StreamGeometry>
            <StreamGeometry x:Key="IconTune">M3 17v2h6v-2H3zM3 5v2h10V5H3zm10 16v-2h8v-2h-8v-2h-2v6h2zM7 9v2H3v2h4v2h2V9H7zm14 4v-2H11v2h10zm-6-4h2V7h4V5h-4V3h-2v6z</StreamGeometry>
            <StreamGeometry x:Key="IconChevronDown">M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z</StreamGeometry>
            <StreamGeometry x:Key="IconVideo">M17 10.5V7c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1v10c0 .55.45 1 1 1h12c.55 0 1-.45 1-1v-3.5l4 4v-11l-4 4z</StreamGeometry>
            <StreamGeometry x:Key="IconVideoOff">M21 6.5l-4 4V7c0-.55-.45-1-1-1H9.82L21 17.18V6.5zM3.27 2L2 3.27 4.73 6H4c-.55 0-1 .45-1 1v10c0 .55.45 1 1 1h12c.21 0 .39-.08.54-.18L19.73 21 21 19.73 3.27 2z</StreamGeometry>
            <StreamGeometry x:Key="IconWave">M7 18h2V6H7v12zm4 4h2V2h-2v20zm-8-8h2v-4H3v4zm12 4h2V6h-2v12zm4-8v4h2v-4h-2z</StreamGeometry>
            <StreamGeometry x:Key="IconShare">M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92 1.61 0 2.92-1.31 2.92-2.92s-1.31-2.92-2.92-2.92z</StreamGeometry>
            <StreamGeometry x:Key="IconFolder">M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z</StreamGeometry>
            <StreamGeometry x:Key="IconDownload">M19 9h-4V3H9v6H5l7 7 7-7zM5 18v3h14v-3H5z</StreamGeometry>
            <StreamGeometry x:Key="IconClose">M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z</StreamGeometry>
            <StreamGeometry x:Key="IconHeadphones">M12 1c-4.97 0-9 4.03-9 9v7c0 1.66 1.34 3 3 3h3v-8H5v-2c0-3.87 3.13-7 7-7s7 3.13 7 7v2h-4v8h3c1.66 0 3-1.34 3-3v-7c0-4.97-4.03-9-9-9z</StreamGeometry>
            <StreamGeometry x:Key="IconExpand">M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z</StreamGeometry>
            <StreamGeometry x:Key="IconCompress">M5 16h3v3h2v-5H5v2zm3-8H5v2h5V5H8v3zm6 11h2v-3h3v-2h-5v5zm2-11V5h-2v5h5V8h-3z</StreamGeometry>
            <StreamGeometry x:Key="IconDelete">M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z</StreamGeometry>
            <StreamGeometry x:Key="IconMore">M12 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z</StreamGeometry>
            <StreamGeometry x:Key="IconInfo">M11 7h2v2h-2zm0 4h2v6h-2zm1-9C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z</StreamGeometry>
            <StreamGeometry x:Key="IconOpen">M19 19H5V5h7V3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z</StreamGeometry>
            <StreamGeometry x:Key="IconDevices">M4 6h18V4H4c-1.1 0-2 .9-2 2v11H0v3h14v-3H4V6zm19 2h-6c-.55 0-1 .45-1 1v10c0 .55.45 1 1 1h6c.55 0 1-.45 1-1V9c0-.55-.45-1-1-1zm-1 9h-4v-7h4v7z</StreamGeometry>
            <StreamGeometry x:Key="IconAdd">M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z</StreamGeometry>
            <StreamGeometry x:Key="IconFlipCamera">M9.5 5.5L8 7H5c-1.1 0-2 .9-2 2v7c0 1.1.9 2 2 2h4v-2H5V9h3.5l1.5-1.5h4L15.5 9H19v4h2V9c0-1.1-.9-2-2-2h-3l-1.5-1.5h-5zM12 15.5c1.38 0 2.5-1.12 2.5-2.5S13.38 10.5 12 10.5 9.5 11.62 9.5 13s1.12 2.5 2.5 2.5zM19 17.5V15l-3.5 3.5L19 22v-2.5c1.65 0 3-1.35 3-3h-2c0 .55-.45 1-1 1z</StreamGeometry>
            <StreamGeometry x:Key="IconPower">M13 3h-2v10h2V3zm4.83 2.17l-1.42 1.42C17.99 7.86 19 9.81 19 12c0 3.87-3.13 7-7 7s-7-3.13-7-7c0-2.19 1.01-4.14 2.58-5.42L6.17 5.17C4.23 6.82 3 9.26 3 12c0 4.97 4.03 9 9 9s9-4.03 9-9c0-2.74-1.23-5.18-3.17-6.83z</StreamGeometry>
            <StreamGeometry x:Key="IconFaders">M6 3h2v6h2v3H8v9H6v-9H4V9h2zM11 3h2v12h2v3h-2v3h-2v-3H9v-3h2zM16 3h2v3h2v3h-2v12h-2V9h-2V6h2z</StreamGeometry>
            <StreamGeometry x:Key="IconBack">M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z</StreamGeometry>
            <StreamGeometry x:Key="IconSearch">M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z</StreamGeometry>
            <StreamGeometry x:Key="IconEdit">M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z</StreamGeometry>
            <StreamGeometry x:Key="IconNotes">M3 18h12v-2H3v2zM3 6v2h18V6H3zm0 7h18v-2H3v2z</StreamGeometry>
            <StreamGeometry x:Key="IconCheck">M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z</StreamGeometry>
            <StreamGeometry x:Key="IconUndo">M12.5 8c-2.65 0-5.05.99-6.9 2.6L2 7v9h9l-3.62-3.62c1.39-1.16 3.16-1.88 5.12-1.88 3.54 0 6.55 2.31 7.6 5.5l2.37-.78C21.08 11.03 17.15 8 12.5 8z</StreamGeometry>
            <StreamGeometry x:Key="IconPlay">M8 5v14l11-7z</StreamGeometry>
            <StreamGeometry x:Key="IconPause">M6 19h4V5H6v14zm8-14v14h4V5h-4z</StreamGeometry>
            <StreamGeometry x:Key="IconRedo">M18.4 10.6C16.55 8.99 14.15 8 11.5 8c-4.65 0-8.58 3.03-9.96 7.22L3.9 16c1.05-3.19 4.05-5.5 7.6-5.5 1.95 0 3.73.72 5.12 1.88L13 16h9V7l-3.6 3.6z</StreamGeometry>
            <StreamGeometry x:Key="IconWarning">M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z</StreamGeometry>
            <StreamGeometry x:Key="IconTrash">M15 16h4v2h-4zm0-8h7v2h-7zm0 4h6v2h-6zM3 18c0 1.1.9 2 2 2h6c1.1 0 2-.9 2-2V8H3v10zM14 5h-3l-1-1H6L5 5H2v2h12z</StreamGeometry>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Dark" Accent="#4C8DFF" RegionColor="#0D0F14" />
                <ColorPaletteResources x:Key="Light" Accent="#2F6FE0" RegionColor="#F2F4F8" />
            </FluentTheme.Palettes>
        </FluentTheme>

        <!-- Text -->
        <Style Selector="TextBlock.title">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="0.6" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style Selector="TextBlock.mono">
            <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,Menlo,monospace" />
        </Style>

        <!-- Cards and surfaces -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="6" />
        </Style>
        <Style Selector="Border.avatar">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
        </Style>
        <Style Selector="Border.avatar.live">
            <Setter Property="Background" Value="{DynamicResource PillLiveBrush}" />
        </Style>
        <Style Selector="Border.avatar c|Icon">
            <Setter Property="Fill" Value="{DynamicResource MutedBrush}" />
        </Style>
        <Style Selector="Border.avatar.live c|Icon">
            <Setter Property="Fill" Value="{DynamicResource LiveBrush}" />
        </Style>

        <!-- Status pill -->
        <Style Selector="Border.pill">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Background" Value="{DynamicResource PillOffBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.pill TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        </Style>
        <Style Selector="Border.pill.live"><Setter Property="Background" Value="{DynamicResource PillLiveBrush}" /></Style>
        <Style Selector="Border.pill.live TextBlock"><Setter Property="Foreground" Value="{DynamicResource LiveBrush}" /></Style>
        <Style Selector="Border.pill.busy"><Setter Property="Background" Value="{DynamicResource PillBusyBrush}" /></Style>
        <Style Selector="Border.pill.busy TextBlock"><Setter Property="Foreground" Value="{DynamicResource WarnBrush}" /></Style>
        <Style Selector="Border.pill.lost"><Setter Property="Background" Value="{DynamicResource PillLostBrush}" /></Style>
        <Style Selector="Border.pill.lost TextBlock"><Setter Property="Foreground" Value="{DynamicResource RecordBrush}" /></Style>

        <!-- Buttons -->
        <Style Selector="Button.tool, Button.primary, Button.chip, Button.seg, Button.icon">
            <Setter Property="MinHeight" Value="{DynamicResource TouchSize}" />
            <Setter Property="MinWidth" Value="{DynamicResource TouchSize}" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.tool">
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.tool:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource StrokeBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
            <Setter Property="Opacity" Value="0.88" />
        </Style>
        <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        </Style>
        <Style Selector="Button.chip">
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="22" />
        </Style>
        <Style Selector="Button.chip.on">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        </Style>
        <Style Selector="Button.chip.on /template/ ContentPresenter#PART_ContentPresenter, Button.chip.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        </Style>
        <Style Selector="Button.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource StrokeBrush}" />
        </Style>
        <Style Selector="Button.seg">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.seg:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.seg.on">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        </Style>
        <Style Selector="Button.seg.on /template/ ContentPresenter#PART_ContentPresenter, Button.seg.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        </Style>
        <Style Selector="Button.icon">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="{DynamicResource TouchSize}" />
        </Style>
        <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
        </Style>
        <Style Selector="c|Icon">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="c|Icon.spinner">
            <Setter Property="RenderTransform" Value="rotate(0deg)" />
        </Style>
        <Style Selector="c|Icon.spinner.spin">
            <Style.Animations>
                <Animation Duration="0:0:0.9" IterationCount="Infinite">
                    <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="c|Icon.chev">
            <Setter Property="Size" Value="22" />
            <Setter Property="Fill" Value="{DynamicResource MutedBrush}" />
        </Style>
        <Style Selector="c|Icon.chev.open">
            <Setter Property="RenderTransform" Value="rotate(180deg)" />
        </Style>
        <!-- On narrow screens header buttons collapse to icons -->
        <Style Selector="Grid.compact TextBlock.btntext">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- Round record button with pulsing ring -->
        <Style Selector="Button.rec">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="112" />
            <Setter Property="Height" Value="112" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel Background="Transparent">
                        <!-- Shown when the button floats over the content (landscape on phones and tablets) -->
                        <Border Name="Disc" Width="90" Height="90" CornerRadius="45" IsVisible="False"
                                Background="{DynamicResource SurfaceBrush}" BoxShadow="0 4 16 0 #40000000" />
                        <Ellipse Name="Ring" Width="84" Height="84" Stroke="{DynamicResource RecordBrush}" StrokeThickness="3" Opacity="0" />
                        <Ellipse Width="84" Height="84" Stroke="{DynamicResource MutedBrush}" StrokeThickness="3" Opacity="0.55" />
                        <Border Name="Core" Width="66" Height="66" CornerRadius="33" Background="{DynamicResource RecordBrush}" />
                    </Panel>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.rec:pressed /template/ Border#Core">
            <Setter Property="Opacity" Value="0.8" />
        </Style>
        <Style Selector="Button.rec:disabled">
            <Setter Property="Opacity" Value="0.35" />
        </Style>
        <Style Selector="Button.rec.recording /template/ Border#Core">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="9" />
        </Style>
        <Style Selector="Button.rec.recording /template/ Ellipse#Ring">
            <Style.Animations>
                <Animation Duration="0:0:1.5" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.85" />
                        <Setter Property="Width" Value="84" />
                        <Setter Property="Height" Value="84" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="Width" Value="112" />
                        <Setter Property="Height" Value="112" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="TextBlock.blink">
            <Style.Animations>
                <Animation Duration="0:0:1.2" IterationCount="Infinite">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.25" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <!-- "REC" / blinking amber "PAUSED" -->
        <Style Selector="TextBlock.reclabel">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource RecordBrush}" />
        </Style>
        <Style Selector="TextBlock.reclabel.paused">
            <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
            <Style.Animations>
                <Animation Duration="0:0:1.2" IterationCount="Infinite">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.25" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.blink">
            <Style.Animations>
                <Animation Duration="0:0:1.2" IterationCount="Infinite">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.25" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Level meter -->
        <Style Selector="c|LevelMeter">
            <Setter Property="TrackBrush" Value="{DynamicResource MeterTrackBrush}" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="{x:Static c:LevelMeter.LevelProperty}" Duration="0:0:0.1" />
                </Transitions>
            </Setter>
        </Style>

        <!-- Chip lists (ListBox with wrapping items) -->
        <Style Selector="ListBox.chips">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </Setter>
            <Setter Property="ItemTemplate">
                <DataTemplate x:DataType="vm:Choice">
                    <TextBlock Text="{Binding Label}" />
                </DataTemplate>
            </Setter>
            <Setter Property="(ScrollViewer.HorizontalScrollBarVisibility)" Value="Disabled" />
            <Setter Property="(ScrollViewer.VerticalScrollBarVisibility)" Value="Disabled" />
        </Style>
        <Style Selector="ListBox.chips > ListBoxItem">
            <Setter Property="MinHeight" Value="{DynamicResource TouchSize}" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="ListBox.chips > ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource StrokeBrush}" />
        </Style>
        <Style Selector="ListBox.chips > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.chips > ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
    </Application.Styles>
</Application>
