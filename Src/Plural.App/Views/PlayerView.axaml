<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Plural.App.ViewModels"
             xmlns:c="using:Plural.App.Controls"
             xmlns:views="using:Plural.App.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="760"
             x:Class="Plural.App.Views.PlayerView"
             x:DataType="vm:PlayerViewModel"
             Focusable="True">

    <UserControl.Styles>
        <Style Selector="Button.titlebtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <!-- Mute / solo buttons of a track row -->
        <Style Selector="Button.ms">
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.ms.big">
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
        </Style>
        <Style Selector="Button.ms.mute.on /template/ ContentPresenter#PART_ContentPresenter, Button.ms.mute.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource WarnBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WarnBrush}" />
            <Setter Property="Foreground" Value="#1A1305" />
        </Style>
        <Style Selector="Button.ms.solo.on /template/ ContentPresenter#PART_ContentPresenter, Button.ms.solo.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        </Style>
        <Style Selector="Button.vidbtn">
            <Setter Property="Background" Value="#99000000" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.vidbtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#CC000000" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.vidbtn.on /template/ ContentPresenter#PART_ContentPresenter, Button.vidbtn.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.menurow">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Margin" Value="0,2" />
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Foreground" Value="{DynamicResource RecordBrush}" />
        </Style>
        <Style Selector="Border.dialog">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="20" />
            <Setter Property="MaxWidth" Value="420" />
            <Setter Property="MinWidth" Value="290" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="BoxShadow" Value="0 10 40 0 #66000000" />
        </Style>
        <!-- Transport bar: normal, and compact in phone landscape (more height for the video) -->
        <Style Selector="Border.transport">
            <Setter Property="Padding" Value="8,4" />
        </Style>
        <Style Selector="Border.transport Button.skip">
            <Setter Property="Width" Value="48" />
        </Style>
        <Style Selector="Border.transport Button.play">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="56" />
            <Setter Property="CornerRadius" Value="28" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Border.transport.compact">
            <Setter Property="Padding" Value="8,0" />
        </Style>
        <Style Selector="Border.transport.compact Button.skip">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
        </Style>
        <Style Selector="Border.transport.compact Button.play">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="CornerRadius" Value="22" />
        </Style>
        <Style Selector="Border.transport.compact Button.tgl">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
        </Style>
        <Style Selector="Button.zoom">
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="24" />
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <!-- One audio track: header (name, mute, solo, gain) and its waveform on the shared timeline -->
        <DataTemplate x:Key="TrackRow" x:DataType="vm:TrackRowViewModel">
            <Border Height="{Binding RowHeight}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="{Binding HeaderWidth}" Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,1,0"
                            Tapped="OnRowHeaderTapped" Holding="OnRowHeaderHolding" ContextRequested="OnRowHeaderContext">
                        <Panel>
                            <Border Width="3" HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}" IsVisible="{Binding IsFocusedRow}" />
                            <!-- tablet / desktop: name, gain fader, M S -->
                            <Grid IsVisible="{Binding IsWideRow}" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="12,0,8,0">
                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                                        <Ellipse Width="9" Height="9" Fill="{Binding Brush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                            <Run Text="{Binding Name}" FontWeight="SemiBold" />
                                            <Run Text="{Binding DeviceSuffix}" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
                                        </TextBlock>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                        <c:GainBar Value="{Binding GainDb}" Height="22" VerticalAlignment="Center" DoubleTapped="OnGainDoubleTapped"
                                   GrooveBrush="{DynamicResource MeterTrackBrush}" FillBrush="{Binding Brush}" KnobBrush="{DynamicResource MutedBrush}"
                                   ToolTip.Tip="Gain (double-click for 0 dB)" />
                                        <TextBlock Grid.Column="1" Classes="muted mono" Text="{Binding GainText}" Width="58" TextAlignment="Right"
                                                   VerticalAlignment="Center" FontSize="11" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Classes="ms mute" Classes.on="{Binding IsMuted}" Command="{Binding ToggleMuteCommand}" Content="M" ToolTip.Tip="Mute (M)" />
                                    <Button Classes="ms solo" Classes.on="{Binding IsSolo}" Command="{Binding ToggleSoloCommand}" Content="S" ToolTip.Tip="Solo (S)" />
                                </StackPanel>
                            </Grid>
                            <!-- phone: just M and S (the name sits on the waveform; long-press opens the gain slider) -->
                            <StackPanel IsVisible="{Binding IsCompact}" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button Classes="ms big mute" Classes.on="{Binding IsMuted}" Command="{Binding ToggleMuteCommand}" Content="M" />
                                <Button Classes="ms big solo" Classes.on="{Binding IsSolo}" Command="{Binding ToggleSoloCommand}" Content="S" />
                            </StackPanel>
                        </Panel>
                    </Border>
                    <Panel ClipToBounds="True">
                        <c:WaveformView Margin="0,6" Peaks="{Binding Peaks}" Scale="{Binding WaveScale}" StartSample="{Binding StartSample}"
                                        SamplesPerPixel="{Binding SamplesPerPixel}" Fill="{Binding Brush}" Dropouts="{Binding Dropouts}"
                                        Pauses="{Binding Pauses}" Opacity="{Binding WaveOpacity}" IsHitTestVisible="False" />
                        <TextBlock Classes="muted" Text="{Binding CantPlayText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource WarnBrush}" IsVisible="{Binding CantPlay}" />
                        <TextBlock Classes="muted" Text="Analyzing audio..." HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsVisible="{Binding ShowAnalyzing}" />
                        <TextBlock Classes="muted" Text="No waveform yet" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsVisible="{Binding ShowNoWaveform}" />
                        <Border IsVisible="{Binding IsCompact}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,4,0,0"
                                CornerRadius="6" Padding="6,1" Background="#99000000" MaxWidth="220" IsHitTestVisible="False">
                            <TextBlock TextTrimming="CharacterEllipsis" FontSize="11" Foreground="White">
                                <Run Text="{Binding Name}" FontWeight="SemiBold" />
                                <Run Text="{Binding DeviceSuffix}" />
                            </TextBlock>
                        </Border>
                        <!-- phone gain slider (long-press the header) -->
                        <Border IsVisible="{Binding IsGainOpen}" Background="{DynamicResource SurfaceBrush}" Padding="12,0,4,0">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                <TextBlock Text="Gain" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Slider Grid.Column="1" Minimum="-40" Maximum="12" Value="{Binding GainDb}" VerticalAlignment="Center" MinHeight="40"
                                        DoubleTapped="OnGainDoubleTapped" />
                                <TextBlock Grid.Column="2" Classes="mono" Text="{Binding GainText}" VerticalAlignment="Center" Width="62" TextAlignment="Right" FontSize="12" />
                                <Button Grid.Column="3" Classes="icon" Command="{Binding CloseGainCommand}" ToolTip.Tip="Done">
                                    <c:Icon Data="{StaticResource IconCheck}" />
                                </Button>
                            </Grid>
                        </Border>
                    </Panel>
                </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Name="Root" RowDefinitions="Auto,Auto,0,Auto,Auto,*" Background="{DynamicResource BgBrush}">

        <!-- Header -->
        <Grid Name="HeaderGrid" Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="8,10,8,4" IsVisible="{Binding NotFullscreen}">
            <Button Classes="icon" Command="{Binding BackCommand}" ToolTip.Tip="Back (Esc)">
                <c:Icon Data="{StaticResource IconBack}" Size="24" />
            </Button>
            <Grid Grid.Column="1" VerticalAlignment="Center" Margin="2,0,0,0">
                <Button Classes="titlebtn" Command="{Binding BeginTitleEditCommand}" IsVisible="{Binding !IsEditingTitle}" ToolTip.Tip="Rename">
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="muted" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Button>
                <TextBox Name="TitleBox" Text="{Binding TitleEdit}" IsVisible="{Binding IsEditingTitle}" MinHeight="44"
                         VerticalContentAlignment="Center" MaxLength="120" PlaceholderText="Title (empty shows the date)"
                         KeyDown="OnTitleKeyDown" LostFocus="OnTitleLostFocus" />
            </Grid>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Classes="icon" Command="{Binding ShareCommand}" IsVisible="{Binding CanShare}" ToolTip.Tip="Share">
                    <c:Icon Data="{StaticResource IconShare}" Size="22" />
                </Button>
                <Button Classes="icon" Command="{Binding OpenMenuCommand}" ToolTip.Tip="More">
                    <c:Icon Data="{StaticResource IconMore}" Size="22" />
                </Button>
            </StackPanel>
        </Grid>

        <views:RecordingBar Name="RecBar" Grid.Row="1" DataContext="{Binding Main}" />

        <!-- Video area: all video tracks, laid out by VideoLayout -->
        <Grid Name="StageHost" Grid.Row="2" ClipToBounds="True" IsVisible="{Binding HasVideo}" Margin="8,2,8,4" ColumnDefinitions="*,Auto" ColumnSpacing="6">
            <c:VideoStage Name="Stage" Tiles="{Binding Videos}" Spotlight="{Binding SpotlightIndex}" Fullscreen="{Binding FullscreenIndex}"
                          Form="{Binding Form}" Animate="{Binding AnimateVideo}" Accent="{DynamicResource AccentBrush}" />
            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Top" IsVisible="{Binding ShowStageToggles}">
                <Button Classes="chip" Classes.on="{Binding AutoSpotlight}" Command="{Binding ToggleAutoSpotlightCommand}"
                        IsVisible="{Binding ShowAutoSpotlight}" ToolTip.Tip="Auto-spotlight: follow whoever is talking" Padding="0">
                    <c:Icon Data="{StaticResource IconMic}" Size="20" />
                </Button>
                <Button Classes="chip" Classes.on="{Binding FocusVideo}" Command="{Binding ToggleFocusVideoCommand}"
                        IsVisible="{Binding ShowFocusToggle}" ToolTip.Tip="Focus video (hide the tracks)" Padding="0">
                    <c:Icon Data="{StaticResource IconVideo}" Size="20" />
                </Button>
                <Button Classes="chip" Command="{Binding ToggleFullscreenCommand}" ToolTip.Tip="Full screen (F)" Padding="0">
                    <Panel>
                        <c:Icon Data="{StaticResource IconExpand}" Size="20" IsVisible="{Binding NotFullscreen}" />
                        <c:Icon Data="{StaticResource IconCompress}" Size="20" IsVisible="{Binding IsFullscreen}" />
                    </Panel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Splitter (tablet / desktop): drag to resize the video area -->
        <Border Name="Splitter" Grid.Row="3" Height="14" Background="Transparent" IsVisible="{Binding ShowSplitter}" Cursor="SizeNorthSouth"
                PointerPressed="OnSplitterPressed" PointerMoved="OnSplitterMoved" PointerReleased="OnSplitterReleased">
            <Border Width="44" Height="4" CornerRadius="2" Background="{DynamicResource StrokeBrush}" VerticalAlignment="Center" />
        </Border>

        <!-- Transport -->
        <Border Name="TransportBar" Grid.Row="4" Classes="transport" Classes.compact="{Binding IsPhoneLandscape}"
                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="2">
                <Button Classes="icon skip" Command="{Binding SkipBackCommand}" ToolTip.Tip="Back 15 s">
                    <Panel Width="30" Height="30">
                        <c:Icon Data="{StaticResource IconUndo}" Size="30" />
                        <TextBlock Text="15" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,5,0,0" />
                    </Panel>
                </Button>
                <Button Grid.Column="1" Classes="primary play" Command="{Binding TogglePlayCommand}"
                        ToolTip.Tip="Play / pause (Space)">
                    <Panel>
                        <c:Icon Data="{StaticResource IconPlay}" Size="30" IsVisible="{Binding !IsPlaying}" />
                        <c:Icon Data="{StaticResource IconPause}" Size="30" IsVisible="{Binding IsPlaying}" />
                    </Panel>
                </Button>
                <Button Grid.Column="2" Classes="icon skip" Command="{Binding SkipForwardCommand}" ToolTip.Tip="Forward 15 s">
                    <Panel Width="30" Height="30">
                        <c:Icon Data="{StaticResource IconRedo}" Size="30" />
                        <TextBlock Text="15" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,5,2,0" />
                    </Panel>
                </Button>
                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="12,0,0,0" Spacing="1">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Classes="mono" Text="{Binding PositionText}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Classes="mono muted" Text="/" FontSize="16" />
                        <TextBlock Classes="mono muted" Text="{Binding DurationText}" FontSize="16" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsBuffering}">
                        <c:Icon Classes="spinner spin" Data="{StaticResource IconRefresh}" Size="14" Fill="{DynamicResource MutedBrush}" />
                        <TextBlock Classes="muted" Text="Buffering" />
                    </StackPanel>
                    <TextBlock Classes="muted" Text="{Binding OutputProblem}" Foreground="{DynamicResource WarnBrush}" TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding HasOutputProblem}" />
                </StackPanel>
                <!-- phone landscape: the video toggles move here from beside the (short) stage -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsVisible="{Binding ShowTransportToggles}">
                    <Button Classes="chip tgl" Classes.on="{Binding AutoSpotlight}" Command="{Binding ToggleAutoSpotlightCommand}"
                            IsVisible="{Binding ShowAutoSpotlight}" ToolTip.Tip="Auto-spotlight: follow whoever is talking" Padding="0">
                        <c:Icon Data="{StaticResource IconMic}" Size="20" />
                    </Button>
                    <Button Classes="chip tgl" Classes.on="{Binding FocusVideo}" Command="{Binding ToggleFocusVideoCommand}"
                            IsVisible="{Binding ShowFocusToggle}" ToolTip.Tip="Focus video (hide the tracks)" Padding="0">
                        <c:Icon Data="{StaticResource IconVideo}" Size="20" />
                    </Button>
                    <Button Classes="chip tgl" Command="{Binding ToggleFullscreenCommand}" ToolTip.Tip="Full screen (F)" Padding="0">
                        <Panel>
                            <c:Icon Data="{StaticResource IconExpand}" Size="20" IsVisible="{Binding NotFullscreen}" />
                            <c:Icon Data="{StaticResource IconCompress}" Size="20" IsVisible="{Binding IsFullscreen}" />
                        </Panel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tracks: overview (zoomed in), time ruler, one row per audio track, shared playhead -->
        <Grid Name="TracksGrid" Grid.Row="5" ColumnDefinitions="104,*" RowDefinitions="Auto,Auto,*" IsVisible="{Binding ShowTracks}">
            <Border Grid.Row="0" Grid.ColumnSpan="2" Height="40" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}"
                    BorderThickness="0,0,0,1" IsVisible="{Binding ShowMinimap}" />
            <TextBlock Grid.Row="0" Classes="muted" Text="Overview" VerticalAlignment="Center" Margin="12,0,0,0" IsVisible="{Binding ShowMinimap}" />
            <Panel Name="MinimapPanel" Grid.Row="0" Grid.Column="1" Height="40" Margin="0,4" IsVisible="{Binding ShowMinimap}">
                <c:WaveformView Peaks="{Binding MinimapPeaks}" Scale="{Binding MinimapScale}" Fill="{DynamicResource MutedBrush}" Opacity="0.7"
                                Margin="0,3" IsHitTestVisible="False" />
                <c:MinimapViewport Name="Minimap" Duration="{Binding DurationSeconds}" ViewStart="{Binding ViewStart}" ViewSpan="{Binding ViewSpan}"
                                   Position="{Binding PositionSeconds}" WindowBrush="{DynamicResource AccentSoftBrush}"
                                   PlayheadBrush="{DynamicResource AccentBrush}" />
            </Panel>

            <Border Grid.Row="1" Height="28" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}"
                    BorderThickness="0,0,1,1">
                <StackPanel Name="ZoomButtons" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsVisible="{Binding !IsPhoneForm}">
                    <Button Classes="icon zoom" Command="{Binding ZoomOutCommand}" ToolTip.Tip="Zoom out (Ctrl+wheel)"><c:Icon Data="{StaticResource IconCompress}" Size="14" /></Button>
                    <Button Classes="icon zoom" Command="{Binding ZoomInCommand}" ToolTip.Tip="Zoom in (Ctrl+wheel)"><c:Icon Data="{StaticResource IconAdd}" Size="14" /></Button>
                    <Button Classes="icon zoom" Command="{Binding ZoomFitCommand}" ToolTip.Tip="Show the whole take"><c:Icon Data="{StaticResource IconExpand}" Size="14" /></Button>
                </StackPanel>
            </Border>

            <ItemsControl Name="RowsList" Grid.Row="2" Grid.ColumnSpan="2" ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource TrackRow}">
                <ItemsControl.Template>
                    <ControlTemplate>
                        <ScrollViewer Name="RowsScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                            <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Classes="muted" Text="This take has no audio tracks." HorizontalAlignment="Center"
                       VerticalAlignment="Top" Margin="24,28" IsVisible="{Binding !HasRows}" />

            <!-- one timeline over the ruler and the rows -->
            <c:TimelineSurface Name="Timeline" Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" IsHitTestVisible="{Binding !AnyGainOpen}"
                               Duration="{Binding DurationSeconds}" ViewStart="{Binding ViewStart}" ViewSpan="{Binding ViewSpan}"
                               Position="{Binding PositionSeconds}" RulerHeight="28" RulerBrush="{DynamicResource SurfaceBrush}"
                               TickBrush="{DynamicResource MutedBrush}" PlayheadBrush="{DynamicResource RecordBrush}" />
        </Grid>

        <!-- Menu -->
        <Grid Grid.RowSpan="6" IsVisible="{Binding IsMenuOpen}">
            <Border Background="{DynamicResource ScrimBrush}" Tapped="OnScrimTapped" />
            <Border Classes="dialog" Padding="14">
                <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Title}" Classes="title" TextTrimming="CharacterEllipsis" Margin="8,4,8,8" />
                    <Button Classes="tool menurow" Command="{Binding MenuNotesCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <c:Icon Data="{StaticResource IconNotes}" />
                            <TextBlock Text="Notes" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="tool menurow" Command="{Binding MenuOpenFolderCommand}" IsVisible="{Binding CanOpenFolder}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <c:Icon Data="{StaticResource IconFolder}" />
                            <TextBlock Text="Open folder" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="tool menurow danger" Command="{Binding MenuDeleteCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <c:Icon Data="{StaticResource IconDelete}" />
                            <TextBlock Text="Delete" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Notes -->
        <Grid Grid.RowSpan="6" IsVisible="{Binding IsNotesOpen}">
            <Border Background="{DynamicResource ScrimBrush}" Tapped="OnScrimTapped" />
            <Border Classes="dialog">
                <StackPanel Spacing="14">
                    <TextBlock Text="Notes" FontSize="18" FontWeight="Bold" />
                    <TextBox Text="{Binding NotesText}" PlaceholderText="Who, where, what to remember" AcceptsReturn="True"
                             TextWrapping="Wrap" MinHeight="140" MaxHeight="260" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Classes="tool" Content="Cancel" Command="{Binding CancelNotesCommand}" />
                        <Button Classes="primary" Content="Save" Command="{Binding SaveNotesCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
