<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Plural.App.ViewModels"
             xmlns:c="using:Plural.App.Controls"
             xmlns:views="using:Plural.App.Views"
             xmlns:p="using:Plural.Core.Platform"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="680"
             x:Class="Plural.App.Views.MainView"
             x:DataType="vm:MainViewModel">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <UserControl.Resources>
        <!-- Updated from code-behind so cards fill the available width. -->
        <x:Double x:Key="CardWidth">320</x:Double>
        <x:Double x:Key="StripWidth">240</x:Double>
        <!-- Camera preview content used by the mixer's small video window (floating on wide windows, docked on phones) -->
        <DataTemplate x:Key="MixerPreviewContent" x:DataType="vm:MainViewModel">
                    <Grid>
                        <c:CameraPreview Surface="{Binding Preview}" IsVisible="{Binding HasPreview}" />
                        <StackPanel IsVisible="{Binding !HasPreview}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" Margin="10">
                            <c:Icon Data="{StaticResource IconVideoOff}" Size="24" Fill="#8E97AB" />
                            <TextBlock Text="{Binding CameraMessage}" Foreground="#C5CBD8" FontSize="11" TextWrapping="Wrap"
                                       TextAlignment="Center" />
                        </StackPanel>
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6" Padding="8,3"
                                Background="#99000000" CornerRadius="10" IsVisible="{Binding IsRecording}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <views:RecDot />
                                <TextBlock Classes.blink="{Binding IsPaused}" Text="{Binding RecordStateText}" Foreground="White" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Button Classes="icon" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="2"
                                Command="{Binding NextCameraCommand}" ToolTip.Tip="Switch camera"
                                IsVisible="{Binding HasMultipleCameras}" IsEnabled="{Binding IsNotRecording}" Foreground="White">
                            <c:Icon Data="{StaticResource IconFlipCamera}" Size="18" />
                        </Button>
                    </Grid>
        </DataTemplate>
        <DataTemplate x:Key="ToastContent" x:DataType="vm:MainViewModel">
            <Border HorizontalAlignment="Center" Margin="12" MaxWidth="560"
                    Padding="16,12" CornerRadius="16" IsVisible="{Binding IsToastVisible}"
                    Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                    BoxShadow="0 6 24 0 #66000000">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <StackPanel VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="{Binding ToastText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Classes="muted" Classes.err="{Binding ToastIsError}" Text="{Binding ToastDetail}" TextWrapping="Wrap"
                                   IsVisible="{Binding HasToastDetail}">
                            <TextBlock.Styles>
                                <Style Selector="TextBlock.muted.err">
                                    <Setter Property="Foreground" Value="{DynamicResource RecordBrush}" />
                                </Style>
                            </TextBlock.Styles>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
                        <Button Classes="tool" Command="{Binding UndoToastCommand}" IsVisible="{Binding HasToastUndo}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <c:Icon Data="{StaticResource IconUndo}" Size="18" />
                                        <TextBlock Text="Undo" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="tool" Command="{Binding ViewTakesCommand}" IsVisible="{Binding HasToastTake}" Content="View takes" />
                        <Button Classes="icon" Command="{Binding ToastTake.ShareCommand}" ToolTip.Tip="Share"
                                IsVisible="{Binding ShowToastShare}">
                            <c:Icon Data="{StaticResource IconShare}" />
                        </Button>
                        <Button Classes="icon" Command="{Binding ToastTake.OpenFolderCommand}" ToolTip.Tip="Open folder"
                                IsVisible="{Binding ShowToastFolder}">
                            <c:Icon Data="{StaticResource IconFolder}" />
                        </Button>
                        <Button Classes="icon" Command="{Binding DismissToastCommand}" ToolTip.Tip="Dismiss">
                            <c:Icon Data="{StaticResource IconClose}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Grid#Root">
            <Setter Property="Background" Value="{DynamicResource BgBrush}" />
        </Style>
        <Style Selector="Grid#Root.immersive">
            <Setter Property="Background" Value="#000000" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Width" Value="{DynamicResource CardWidth}" />
        </Style>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="6" />
        </Style>
        <Style Selector="Border.segbox">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style Selector="Button.menuitem">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="60" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
        <Style Selector="Border.strip">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        </Style>
        <Style Selector="Border.bar">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border#BottomBar">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        </Style>

        <!-- Immersive video: everything floats over the camera on translucent dark scrims -->
        <Style Selector="Grid#Root.immersive Border.bar">
            <Setter Property="Background" Value="#80000000" />
        </Style>
        <Style Selector="Grid#Root.immersive Border#BottomBar">
            <Setter Property="Background" Value="#B3000000" />
        </Style>
        <Style Selector="Grid#Root.immersive Border.card, Grid#Root.immersive Border.panel, Grid#Root.immersive Border.strip">
            <Setter Property="Background" Value="#C0121520" />
        </Style>
        <Style Selector="Grid#Root.immersive Border.segbox">
            <Setter Property="Background" Value="#99000000" />
        </Style>

        <Style Selector="Border#SettingsSheet, Border#AddMicSheet, Border#DevicesSheet, Border#AboutSheet, Border#MenuSheet">
            <Setter Property="Width" Value="440" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="CornerRadius" Value="20,0,0,20" />
        </Style>
        <Style Selector="Grid#Root.compact Border#SettingsSheet, Grid#Root.compact Border#AddMicSheet, Grid#Root.compact Border#DevicesSheet, Grid#Root.compact Border#AboutSheet, Grid#Root.compact Border#MenuSheet">
            <Setter Property="Width" Value="NaN" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="Grid#Root.compact Border#BottomBar">
            <Setter Property="CornerRadius" Value="20,20,0,0" />
        </Style>
        <Style Selector="Grid#Root TextBlock.compactonly">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Grid#Root.compact TextBlock.compactonly">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="Grid#Root.compact TextBlock.wideonly">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Grid#Root.compact Button.chip c|Icon.wideonly">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Grid#Root.compact Button.seg">
            <Setter Property="Padding" Value="12,0" />
        </Style>
        <!-- Short windows (phone landscape): smaller record button -->
        <!-- Phone width while recording: room for Pause and Takes only -->
        <Style Selector="Grid#Root.compact.recui Button.mixchip">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Grid#Root.short Button.rec">
            <Setter Property="RenderTransform" Value="scale(0.72)" />
            <Setter Property="Width" Value="84" />
            <Setter Property="Height" Value="84" />
        </Style>
        <Style Selector="Grid#Root.short Border#BottomBar">
            <Setter Property="Padding" Value="16,0,16,0" />
        </Style>

        <!-- Cards slide down and fade while recording; the compact strip slides up -->
        <Style Selector="StackPanel#CardsPanel">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="RenderTransform" Value="translateY(0px)" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="StackPanel#CardsPanel.away">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform" Value="translateY(80px)" />
        </Style>
        <Style Selector="Border#Strip">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform" Value="translateY(60px)" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border#Strip.on">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="RenderTransform" Value="translateY(0px)" />
        </Style>

        <!-- Mixer console -->
        <Style Selector="Border.console">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Border.pip">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Background" Value="#000000" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BoxShadow" Value="0 6 24 0 #66000000" />
        </Style>
        <Style Selector="Border.pipfloat">
            <Setter Property="Width" Value="320" />
            <Setter Property="Height" Value="180" />
            <Setter Property="Margin" Value="12" />
        </Style>
        <Style Selector="Border.pipdock">
            <Setter Property="Width" Value="208" />
            <Setter Property="Height" Value="117" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style Selector="Grid#Root.compact Border.pipfloat, Grid#Root:not(.compact) Border.pipdock">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Height" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="Border.chstrip">
            <Setter Property="Width" Value="108" />
            <Setter Property="Padding" Value="8,10" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
        </Style>
        <Style Selector="Border.chstrip.master">
            <Setter Property="Width" Value="124" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
        </Style>
        <Style Selector="TextBlock.chlabel">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.chvalue">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.chstate">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.chsmall">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        </Style>
        <Style Selector="c|Knob">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TrackBrush" Value="{DynamicResource MeterTrackBrush}" />
            <Setter Property="ValueBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="CapBrush" Value="{DynamicResource Surface2Brush}" />
            <Setter Property="PointerBrush" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>
        <Style Selector="c|Fader">
            <Setter Property="GrooveBrush" Value="{DynamicResource MeterTrackBrush}" />
            <Setter Property="ScaleBrush" Value="{DynamicResource MutedBrush}" />
            <Setter Property="CapLineBrush" Value="#2A2E36" />
            <Setter Property="CapBrush">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Color="#E4E7EE" Offset="0" />
                    <GradientStop Color="#B9BFCA" Offset="0.5" />
                    <GradientStop Color="#9097A4" Offset="1" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="c|MixerMeter">
            <Setter Property="TrackBrush" Value="{DynamicResource MeterTrackBrush}" />
        </Style>
        <Style Selector="ComboBox.mini">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="6,0,0,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="ToggleButton.led, ToggleButton.mute">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        </Style>
        <Style Selector="ToggleButton.mute">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="ToggleButton.led:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.led:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="ToggleButton.mute:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.mute:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RecordBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource RecordBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.power">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        </Style>
        <Style Selector="Button.power.busy">
            <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
        </Style>
        <Style Selector="Button.power.on /template/ ContentPresenter#PART_ContentPresenter, Button.power.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource LiveBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LiveBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Border.scribble">
            <Setter Property="Background" Value="#0B0D12" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="4,5" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
        </Style>
        <Style Selector="Border.scribble TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#E6E9F0" />
        </Style>
        <Style Selector="Border.scribble.live">
            <Setter Property="BorderBrush" Value="{DynamicResource LiveBrush}" />
        </Style>
        <Style Selector="Border.scribble.rec">
            <Setter Property="BorderBrush" Value="{DynamicResource RecordBrush}" />
        </Style>
        <Style Selector="Border.scribble.warn">
            <Setter Property="BorderBrush" Value="{DynamicResource WarnBrush}" />
        </Style>
        <Style Selector="TextBlock.chstate.warn">
            <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
        </Style>
    </UserControl.Styles>

    <ThemeVariantScope Name="Scope">
    <Grid Name="Root" RowDefinitions="Auto,Auto,*,Auto">

        <!-- Immersive camera layer: fills the whole view behind everything -->
        <Grid Grid.RowSpan="4" IsVisible="{Binding ImmersiveActive}" IsHitTestVisible="False">
            <c:CameraPreview Surface="{Binding Preview}" Cover="True" IsVisible="{Binding HasPreview}" />
            <TextBlock IsVisible="{Binding !HasPreview}" Text="{Binding CameraMessage}" Foreground="#C5CBD8"
                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>

        <!-- Header -->
        <Border Grid.Row="0" Classes="bar">
            <Grid ColumnDefinitions="*,Auto" Margin="18,14,12,6">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Plural" FontSize="22" FontWeight="Bold" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                 Fill="{DynamicResource LiveBrush}" IsVisible="{Binding HasLiveMic}" />
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                 Fill="{DynamicResource MutedBrush}" IsVisible="{Binding !HasLiveMic}" />
                        <TextBlock Classes="muted" Text="{Binding Summary}" VerticalAlignment="Center" />
                        <c:Icon Classes="spinner spin" Data="{StaticResource IconRefresh}" Size="14" IsVisible="{Binding IsScanning}"
                                Fill="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                            IsVisible="{Binding ShowControls}">
                    <Button Classes="tool" ToolTip.Tip="Menu" Command="{Binding OpenMenuCommand}">
                        <c:Icon Data="{StaticResource IconMore}" />
                    </Button>
                </StackPanel>
                <Border Grid.Column="1" IsVisible="{Binding IsRecordingUi}" VerticalAlignment="Center" Padding="12,6"
                        Background="#33FF4D5E" CornerRadius="16">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <views:RecDot />
                        <TextBlock Classes="reclabel" Classes.paused="{Binding IsPaused}" Text="{Binding RecordStateText}" VerticalAlignment="Center" />
                        <TextBlock Classes="mono" Text="{Binding RecordingTime}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Video tools (camera switch, full-screen preview) -->
        <Border Grid.Row="1" Classes="bar" IsVisible="{Binding ShowVideoTools}">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="18,6,12,4">
                <Button Classes="tool" Command="{Binding NextCameraCommand}" IsVisible="{Binding HasMultipleCameras}"
                        ToolTip.Tip="Switch camera">
                    <c:Icon Data="{StaticResource IconFlipCamera}" />
                </Button>
                <Button Classes="tool" Command="{Binding ToggleImmersiveCommand}" ToolTip.Tip="Full-screen preview">
                    <Panel>
                        <c:Icon Size="24" Data="{StaticResource IconExpand}" IsVisible="{Binding !IsImmersive}" />
                        <c:Icon Size="24" Data="{StaticResource IconCompress}" IsVisible="{Binding IsImmersive}" />
                    </Panel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Content -->
        <Panel Grid.Row="2">
            <ScrollViewer Name="BodyScroll" IsVisible="{Binding IsCardsMode}">
                <Grid Name="Body" Margin="12,6,12,24" RowDefinitions="Auto,Auto,*" ColumnDefinitions="*">

                    <StackPanel Grid.Row="0">
                        <Border Classes="panel" Margin="6,4" Padding="14,10" IsVisible="{Binding IsControlled}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <c:Icon Data="{StaticResource IconDevices}" VerticalAlignment="Center" Fill="{DynamicResource AccentBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ControllerText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Classes="muted" Text="{Binding ControllerDetail}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="2" Classes="tool" Content="Disconnect" Command="{Binding DisconnectControllerCommand}"
                                        IsVisible="{Binding IsControllerConnected}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border Classes="bar" CornerRadius="10" Padding="8,4" Margin="6,4,6,4" HorizontalAlignment="Left"
                                IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Classes="muted" Text="{Binding Status}" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>

                    <!-- Camera preview panel (non-immersive) -->
                    <Border Name="PreviewPanel" Grid.Row="1" IsVisible="{Binding ShowPreviewPanel}" Margin="6"
                            CornerRadius="{DynamicResource RadiusCard}" ClipToBounds="True" Background="#000000"
                            VerticalAlignment="Top">
                        <Grid>
                            <c:CameraPreview Surface="{Binding Preview}" IsVisible="{Binding HasPreview}" />

                            <StackPanel IsVisible="{Binding !HasPreview}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Spacing="10" Margin="24">
                                <c:Icon Data="{StaticResource IconVideoOff}" Size="40" Fill="#8E97AB" />
                                <TextBlock Text="{Binding CameraMessage}" Foreground="#C5CBD8" TextWrapping="Wrap"
                                           TextAlignment="Center" MaxWidth="320" />
                            </StackPanel>

                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Padding="12,6"
                                    Background="#99000000" CornerRadius="16" IsVisible="{Binding IsRecording}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <views:RecDot />
                                    <TextBlock Classes.blink="{Binding IsPaused}" Text="{Binding RecordStateText}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" />
                                    <TextBlock Classes="mono" Text="{Binding RecordingTime}" Foreground="White" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Mic cards -->
                    <StackPanel Name="CardsPanel" Grid.Row="2" VerticalAlignment="Top"
                                Classes.away="{Binding HideCards}" IsVisible="{Binding !CardsGone}"
                                IsHitTestVisible="{Binding !HideCards}">
                        <Border Classes="panel" IsVisible="{Binding ShowEmptyState}" Padding="24">
                            <StackPanel Spacing="8" HorizontalAlignment="Center">
                                <c:Icon Data="{StaticResource IconMic}" Size="40" Fill="{DynamicResource MutedBrush}" />
                                <TextBlock Text="No mics yet" Classes="title" HorizontalAlignment="Center" />
                                <TextBlock Classes="muted" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360"
                                           Text="Pair SmartMikes in your system's Bluetooth settings and tap Scan, add a microphone of this device, or record with other devices under Devices." />
                                <Button Classes="primary" Command="{Binding OpenAddMicCommand}" IsVisible="{Binding CanAddMics}"
                                        HorizontalAlignment="Center" Margin="0,6,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <c:Icon Data="{StaticResource IconAdd}" />
                                        <TextBlock Text="Add a microphone" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                        <!-- Remote devices this app controls -->
                        <ItemsControl ItemsSource="{Binding Remotes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RemoteDeviceViewModel">
                                    <Border Classes="card">
                                        <StackPanel Spacing="12">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <Border Classes="avatar" Classes.live="{Binding IsLive}">
                                                    <c:Icon Data="{StaticResource IconDevices}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="3">
                                                    <TextBlock Classes="title" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Classes="muted" Text="{Binding Details}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Border Grid.Column="2" Classes="pill" Classes.live="{Binding IsLive}"
                                                        Classes.busy="{Binding IsConnecting}" Classes.lost="{Binding IsLost}">
                                                    <TextBlock Text="{Binding StateText}" />
                                                </Border>
                                            </Grid>

                                            <c:LevelMeter Level="{Binding Level}" Peak="{Binding PeakHold}" />

                                            <TextBlock Classes="muted" Text="{Binding SyncText}" IsVisible="{Binding IsSyncing}" />

                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                <Button Classes="tool" Command="{Binding ConnectMicsCommand}" IsEnabled="{Binding CanChange}"
                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                        ToolTip.Tip="Connect the mics on that device">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <c:Icon Data="{StaticResource IconLink}" />
                                                        <TextBlock Text="Connect mics" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Grid.Column="1" Classes="chip" Classes.on="{Binding IsVideo}" Command="{Binding ToggleModeCommand}"
                                                        IsEnabled="{Binding CanChange}" IsVisible="{Binding HasVideo}"
                                                        ToolTip.Tip="Record audio only, or video too, on that device">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <c:Icon Data="{StaticResource IconMic}" IsVisible="{Binding !IsVideo}" />
                                                        <c:Icon Data="{StaticResource IconVideo}" IsVisible="{Binding IsVideo}" />
                                                        <TextBlock Text="{Binding ModeText}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Grid.Column="2" Classes="tool" Command="{Binding DisconnectCommand}"
                                                        ToolTip.Tip="Stop controlling this device">
                                                    <c:Icon Data="{StaticResource IconClose}" />
                                                </Button>
                                            </Grid>

                                            <TextBlock Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                       Foreground="{DynamicResource RecordBrush}" TextWrapping="Wrap" FontSize="12" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl Name="Cards" ItemsSource="{Binding Mikes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MikeViewModel">
                                    <Border Classes="card">
                                        <StackPanel Spacing="12">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <Border Classes="avatar" Classes.live="{Binding IsStreaming}">
                                                    <c:Icon Data="{StaticResource IconMic}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="3">
                                                    <TextBlock Classes="title" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasBattery}">
                                                            <Panel Width="22" Height="12" VerticalAlignment="Center">
                                                                <Border BorderBrush="{DynamicResource MutedBrush}" BorderThickness="1.5"
                                                                        CornerRadius="3" Width="20" HorizontalAlignment="Left" />
                                                                <Border Width="{Binding BatteryFill}" Height="6" Margin="2,0,0,0"
                                                                        HorizontalAlignment="Left" CornerRadius="1.5"
                                                                        Background="{DynamicResource LiveBrush}" Classes.low="{Binding IsBatteryLow}">
                                                                    <Border.Styles>
                                                                        <Style Selector="Border.low">
                                                                            <Setter Property="Background" Value="{DynamicResource RecordBrush}" />
                                                                        </Style>
                                                                    </Border.Styles>
                                                                </Border>
                                                                <Border Width="2" Height="5" HorizontalAlignment="Right" CornerRadius="1"
                                                                        Background="{DynamicResource MutedBrush}" />
                                                            </Panel>
                                                            <TextBlock Classes="muted" Text="{Binding BatteryText}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <TextBlock Classes="muted" Foreground="{DynamicResource WarnBrush}" FontWeight="SemiBold"
                                                                   Text="{Binding ReconnectText}" IsVisible="{Binding IsReconnecting}" />
                                                        <c:Icon Data="{StaticResource IconHeadphones}" Size="16" Fill="{DynamicResource MutedBrush}" IsVisible="{Binding HasHeadphones}" />
                                                        <TextBlock Classes="muted" Text="Local mic" IsVisible="{Binding IsLocal}" />
                                                        <TextBlock Classes="muted" Text="{Binding MissingText}" Foreground="{DynamicResource WarnBrush}"
                                                                   IsVisible="{Binding NotPaired}" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <Border Grid.Column="2" Classes="pill" Classes.live="{Binding IsStreaming}"
                                                        Classes.busy="{Binding IsConnecting}" Classes.lost="{Binding IsLost}">
                                                    <TextBlock Text="{Binding StateText}" />
                                                </Border>
                                            </Grid>

                                            <c:LevelMeter Level="{Binding Level}" Peak="{Binding PeakHold}" />

                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                <Button Classes="primary" Classes.tool="{Binding IsStreaming}"
                                                        Content="{Binding ConnectButtonText}" Command="{Binding ToggleConnectionCommand}"
                                                        IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Stretch" />
                                                <Button Grid.Column="1" Classes="tool" Command="{Binding ToggleExpandedCommand}"
                                                        ToolTip.Tip="Mic settings">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <c:Icon Data="{StaticResource IconTune}" />
                                                        <c:Icon Classes="chev" Classes.open="{Binding IsExpanded}" Data="{StaticResource IconChevronDown}" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Grid.Column="2" Classes="tool" Command="{Binding RemoveCommand}"
                                                        IsEnabled="{Binding CanRemove}" ToolTip.Tip="Remove this mic from the list">
                                                    <c:Icon Data="{StaticResource IconDelete}" />
                                                </Button>
                                            </Grid>

                                            <StackPanel IsVisible="{Binding IsExpanded}" Spacing="14">
                                                <Border Height="1" Background="{DynamicResource StrokeBrush}" />
                                                <StackPanel Spacing="14" IsVisible="{Binding IsSmartMike}">
                                                <StackPanel Spacing="6">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Text="Mic gain" VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Classes="muted" Text="Auto (AGC)" VerticalAlignment="Center" />
                                                            <ToggleSwitch IsChecked="{Binding Agc}" OnContent="" OffContent="" MinWidth="0" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <Slider Minimum="0" Maximum="100" Value="{Binding MicGain}" IsEnabled="{Binding !Agc}" />
                                                </StackPanel>
                                                <StackPanel Spacing="6">
                                                    <TextBlock Text="Headphone monitor" />
                                                    <Slider Minimum="0" Maximum="100" Value="{Binding MonitorVolume}" />
                                                </StackPanel>
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Text="Noise suppression" VerticalAlignment="Center" />
                                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding NoiseSuppression}" OnContent="" OffContent="" MinWidth="0" />
                                                </Grid>
                                                </StackPanel>
                                                <StackPanel Spacing="6">
                                                    <TextBlock Classes="muted" Text="{Binding OutputLabel}" />
                                                    <ComboBox ItemsSource="{Binding Outputs}" SelectedItem="{Binding SelectedOutput}"
                                                              HorizontalAlignment="Stretch" MinHeight="44" />
                                                </StackPanel>
                                            </StackPanel>

                                            <TextBlock Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                       Foreground="{DynamicResource RecordBrush}" TextWrapping="Wrap" FontSize="12" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- Mixer: one channel strip per mic, and a master strip that plays the mix of all mics to one output.
                 Faders and mutes act on the recording and the outputs immediately, also while recording. -->
            <Grid IsVisible="{Binding IsMixerMode}" RowDefinitions="Auto,*" Margin="12,6,12,12">
            <!-- Video in mixer mode (phones): docked above the console so it never covers a strip -->
            <Border Classes="pip pipdock" IsVisible="{Binding ShowMixerPreview}" HorizontalAlignment="Center">
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MixerPreviewContent}" />
            </Border>
            <Border Name="Mixer" Grid.Row="1" Classes="console">
                <Grid ColumnDefinitions="*,Auto">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <Grid>
                            <TextBlock Classes="muted" IsVisible="{Binding !HasMikes}" Margin="24" MaxWidth="280"
                                       VerticalAlignment="Center" HorizontalAlignment="Left" TextWrapping="Wrap"
                                       Text="No mics yet. Scan for paired SmartMikes or add a microphone from the menu." />
                            <ItemsControl ItemsSource="{Binding Mikes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MikeViewModel">
                                        <Border Classes="chstrip">
                                            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto" RowSpacing="8">
                                                <!-- Power (connect) and state -->
                                                <Grid ColumnDefinitions="Auto,*" Height="36">
                                                    <Button Classes="power" Classes.on="{Binding IsStreaming}" Classes.busy="{Binding IsConnecting}"
                                                            Command="{Binding ToggleConnectionCommand}" IsEnabled="{Binding !IsBusy}"
                                                            ToolTip.Tip="{Binding ConnectButtonText}">
                                                        <c:Icon Data="{StaticResource IconPower}" Size="16" />
                                                    </Button>
                                                    <StackPanel Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" Spacing="1">
                                                        <TextBlock Classes="chstate" Classes.warn="{Binding IsConnecting}" Text="{Binding StripStateText}" />
                                                        <TextBlock Classes="chsmall" Text="{Binding BatteryText}" IsVisible="{Binding HasBattery}" />
                                                        <TextBlock Classes="chsmall" Text="Local mic" IsVisible="{Binding IsLocal}" />
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Mic section (SmartMike settings); fixed height so all faders line up -->
                                                <Panel Grid.Row="1" Height="196">
                                                    <StackPanel IsVisible="{Binding IsSmartMike}" Spacing="6">
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Classes="chlabel" Text="GAIN" />
                                                            <c:Knob Minimum="0" Maximum="100" SmallChange="2" LargeChange="10" DefaultValue="50"
                                                                    Value="{Binding MicGain}" IsEnabled="{Binding !Agc}"
                                                                    ToolTip.Tip="Mic gain on the SmartMike (turn AGC off to set it)" />
                                                            <TextBlock Classes="chvalue" Text="{Binding MicGain}" />
                                                        </StackPanel>
                                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                                                            <ToggleButton Classes="led" Content="AGC" IsChecked="{Binding Agc}" ToolTip.Tip="Automatic gain" />
                                                            <ToggleButton Grid.Column="1" Classes="led" Content="NS" IsChecked="{Binding NoiseSuppression}"
                                                                          ToolTip.Tip="Noise suppression" />
                                                        </Grid>
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Classes="chlabel" Text="PHONES" />
                                                            <c:Knob Minimum="0" Maximum="100" SmallChange="2" LargeChange="10" DefaultValue="80"
                                                                    Value="{Binding MonitorVolume}" ToolTip.Tip="Headphone monitor on the SmartMike" />
                                                            <TextBlock Classes="chvalue" Text="{Binding MonitorVolume}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <StackPanel IsVisible="{Binding IsLocal}" VerticalAlignment="Center" Spacing="6">
                                                        <c:Icon Data="{StaticResource IconMic}" Size="28" Fill="{DynamicResource MutedBrush}" HorizontalAlignment="Center" />
                                                        <TextBlock Classes="chsmall" Text="Device mic" HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                    <!-- SmartMike link lost: amber banner over the mic section; a running take keeps recording -->
                                                    <Border IsVisible="{Binding IsReconnecting}" Background="{DynamicResource Surface2Brush}" CornerRadius="8"
                                                            BorderBrush="{DynamicResource WarnBrush}" BorderThickness="1" Padding="4">
                                                        <StackPanel VerticalAlignment="Center" Spacing="6">
                                                            <c:Icon Classes="spinner spin" Data="{StaticResource IconRefresh}" Size="22" Fill="{DynamicResource WarnBrush}" />
                                                            <StackPanel Spacing="1">
                                                                <TextBlock Classes="chstate warn" FontSize="10" TextAlignment="Center" HorizontalAlignment="Center" Text="Reconnecting…" />
                                                                <TextBlock Classes="chstate warn mono" TextAlignment="Center" HorizontalAlignment="Center" Text="{Binding ReconnectClock}" />
                                                            </StackPanel>
                                                            <TextBlock Classes="chsmall" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"
                                                                       Text="Recording continues" IsVisible="{Binding IsRecording}" />
                                                        </StackPanel>
                                                    </Border>
                                                </Panel>

                                                <!-- Direct output of this mic -->
                                                <StackPanel Grid.Row="2" Spacing="3">
                                                    <TextBlock Classes="chlabel" Text="DIRECT OUT" />
                                                    <ComboBox Classes="mini" ItemsSource="{Binding Outputs}" SelectedItem="{Binding SelectedOutput}"
                                                              ToolTip.Tip="{Binding OutputLabel}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:OutputOption">
                                                                <TextBlock Text="{Binding ShortName}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </StackPanel>

                                                <!-- Fader and post-fader meter -->
                                                <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="6" MinHeight="150">
                                                    <c:Fader Value="{Binding FaderDb}" ToolTip.Tip="Level in the recording and outputs (double-tap: 0 dB)" />
                                                    <c:MixerMeter Grid.Column="1" Width="8" Margin="0,18" Level="{Binding MixLevel}" Peak="{Binding MixPeakHold}" />
                                                </Grid>
                                                <TextBlock Grid.Row="4" Classes="chvalue mono" Text="{Binding FaderText}" />
                                                <ToggleButton Grid.Row="5" Classes="mute" Content="MUTE" IsChecked="{Binding Muted}"
                                                              ToolTip.Tip="Mute this mic in the recording and outputs" />
                                                <Border Grid.Row="6" Classes="scribble" Classes.live="{Binding IsStreaming}" Classes.rec="{Binding IsRecording}" Classes.warn="{Binding IsReconnecting}"
                                                        ToolTip.Tip="{Binding Error}">
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>

                    <!-- Video in mixer mode (wide windows): the camera as a small floating window over the console -->
                    <Border Classes="pip pipfloat" IsVisible="{Binding ShowMixerPreview}" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MixerPreviewContent}" />
                    </Border>

                    <!-- Master: the mix of all mics (after their faders) to one live output -->
                    <Border Grid.Column="1" Classes="chstrip master">
                        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto" RowSpacing="8">
                            <StackPanel Height="36" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Classes="chstate" Text="MASTER" />
                                <TextBlock Classes="chsmall" Text="Live mix" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Height="252" Spacing="3">
                                <TextBlock Classes="chlabel" Text="MIX OUT" />
                                <ComboBox Classes="mini" ItemsSource="{Binding MixOutputs}" SelectedItem="{Binding SelectedMixOutput}"
                                          ToolTip.Tip="Play the mix of all mics on this output">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:OutputOption">
                                                                <TextBlock Text="{Binding ShortName}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                <TextBlock Classes="chsmall" Text="{Binding MixError}" IsVisible="{Binding HasMixError}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource RecordBrush}" />
                                <TextBlock Classes="chsmall" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="Live only: each mic still records to its own track." />
                            </StackPanel>
                            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="6" MinHeight="150">
                                <c:Fader Value="{Binding MixFaderDb}" ToolTip.Tip="Master level of the mix output (double-tap: 0 dB)" />
                                <c:MixerMeter Grid.Column="1" Width="10" Margin="0,18" Level="{Binding MixLevel}" Peak="{Binding MixPeakHold}" />
                            </Grid>
                            <TextBlock Grid.Row="3" Classes="chvalue mono" Text="{Binding MixFaderText}" />
                            <ToggleButton Grid.Row="4" Classes="mute" Content="MUTE" IsChecked="{Binding MixMuted}"
                                          ToolTip.Tip="Mute the mix output" />
                            <Border Grid.Row="5" Classes="scribble" Classes.rec="{Binding IsRecording}">
                                <TextBlock Text="MIX" HorizontalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            </Grid>

            <!-- Big timer in the middle while recording audio -->
            <StackPanel IsVisible="{Binding ShowRecordingCenter}" IsHitTestVisible="False" Spacing="6"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Classes="mono" Text="{Binding RecordingTime}" FontSize="56" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Classes="muted" Classes.blink="{Binding IsPaused}" Text="{Binding RecordingCaption}" HorizontalAlignment="Center" />
            </StackPanel>

            <StackPanel VerticalAlignment="Bottom">
                <!-- Toast (the same one floats over the Takes and Player pages, see the page layer) -->
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ToastContent}" IsVisible="{Binding IsRecorderPage}" />

                <!-- Compact strip of the recording mics (name + meter) -->
                <Border Name="Strip" Classes="strip" Classes.on="{Binding StripOn}" IsVisible="{Binding ShowStrip}"
                        Margin="12,0,12,8" Padding="8,6" CornerRadius="16" HorizontalAlignment="Center"
                        BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                    <StackPanel>
                    <ItemsControl ItemsSource="{Binding Remotes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RemoteDeviceViewModel">
                                <StackPanel Width="{DynamicResource StripWidth}" IsVisible="{Binding IsRecording}" Margin="6,4" Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBlock Classes="muted" FontSize="11" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Classes="muted" FontSize="11" Foreground="{DynamicResource WarnBrush}"
                                                   Text="{Binding RecordingNote}" IsVisible="{Binding RecordingNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </Grid>
                                    <c:LevelMeter Height="6" Level="{Binding Level}" Peak="{Binding PeakHold}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Mikes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MikeViewModel">
                                <StackPanel Width="{DynamicResource StripWidth}" IsVisible="{Binding IsRecording}" Margin="6,4" Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBlock Classes="muted" FontSize="11" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Classes="chstate warn" FontSize="11"
                                                   Text="{Binding ReconnectText}" IsVisible="{Binding IsReconnecting}" />
                                    </Grid>
                                    <c:LevelMeter Height="6" Level="{Binding Level}" Peak="{Binding PeakHold}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Panel>

        <!-- Bottom bar: [format chip] [video toggle]  (Record)  [Takes] -->
        <Border Grid.Row="3" Name="BottomBar" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="16,6,16,10">
            <StackPanel>
                <TextBlock Classes="muted" Text="{Binding RecordHint}" IsVisible="{Binding HasRecordHint}"
                           HorizontalAlignment="Center" Margin="0,4,0,0" />
                <TextBlock Classes="muted" Foreground="{DynamicResource WarnBrush}" Text="{Binding PreflightText}"
                           IsVisible="{Binding HasPreflight}" TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" Margin="0,4,0,0" />
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" Margin="0,4,0,0"
                            IsVisible="{Binding HasSpaceHint}">
                    <c:Icon Data="{StaticResource IconWarning}" Size="14" Fill="{DynamicResource WarnBrush}" />
                    <TextBlock Classes="muted" Foreground="{DynamicResource WarnBrush}" Text="{Binding SpaceHint}" />
                </StackPanel>
                <Panel>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Button Classes="chip" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="Recording settings"
                                IsVisible="{Binding ShowControls}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <c:Icon Classes="wideonly" Data="{StaticResource IconTune}" />
                                <TextBlock Classes="wideonly" Text="{Binding FormatChip}" VerticalAlignment="Center" />
                                <TextBlock Classes="compactonly" Text="{Binding FormatShort}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="chip" Classes.on="{Binding IsVideoMode}" Command="{Binding ToggleModeCommand}"
                                IsVisible="{Binding ShowModeSeg}" ToolTip.Tip="Switch between audio and video recording">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <c:Icon Data="{StaticResource IconMic}" IsVisible="{Binding IsAudioMode}" />
                                <c:Icon Data="{StaticResource IconVideo}" IsVisible="{Binding IsVideoMode}" />
                                <TextBlock Classes="wideonly" Text="{Binding ModeLabel}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="chip mixchip" Classes.on="{Binding IsMixerMode}" Command="{Binding ToggleMixerCommand}"
                                ToolTip.Tip="Mixer: adjust every mic, also while recording">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <c:Icon Data="{StaticResource IconFaders}" />
                                <TextBlock Classes="wideonly" Text="Mixer" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <!-- While recording: Pause/Resume and the Takes page (the settings, mode and mixer chips are hidden) -->
                        <Button Classes="chip" Classes.on="{Binding IsPaused}" Command="{Binding TogglePauseCommand}"
                                IsVisible="{Binding IsRecording}" IsEnabled="{Binding CanPause}"
                                ToolTip.Tip="Pause or resume the recording">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <c:Icon Data="{StaticResource IconPause}" IsVisible="{Binding !IsPaused}" />
                                <c:Icon Data="{StaticResource IconPlay}" IsVisible="{Binding IsPaused}" />
                                <TextBlock Classes="wideonly" Text="{Binding PauseButtonText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="chip" Command="{Binding OpenTakesCommand}" IsVisible="{Binding IsRecordingUi}"
                                ToolTip.Tip="Recorded takes (recording continues)">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <c:Icon Data="{StaticResource IconFolder}" />
                                <TextBlock Classes="wideonly" Text="Takes" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Button HorizontalAlignment="Center" Classes="rec" Classes.recording="{Binding IsRecording}"
                            Command="{Binding ToggleRecordingCommand}" IsEnabled="{Binding CanRecord}"
                            ToolTip.Tip="Record / stop" />
                    <Button Classes="chip" Command="{Binding OpenTakesCommand}" HorizontalAlignment="Right" VerticalAlignment="Center"
                            IsVisible="{Binding ShowControls}" ToolTip.Tip="Recorded takes">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <c:Icon Data="{StaticResource IconFolder}" />
                            <TextBlock Classes="wideonly" Text="Takes" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" IsVisible="{Binding IsRecording}">
                        <TextBlock Classes="mono" Text="{Binding RecordingTime}" FontSize="24" FontWeight="SemiBold"
                                   HorizontalAlignment="Right" />
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                            <views:RecDot />
                            <TextBlock Classes="reclabel" Classes.paused="{Binding IsPaused}" FontSize="12" Text="{Binding RecordStateText}" />
                        </StackPanel>
                    </StackPanel>
                </Panel>
            </StackPanel>
        </Border>

        <!-- Pages above the recorder (Takes, Player). The recorder keeps running underneath; recording continues. -->
        <Grid Grid.RowSpan="4" IsVisible="{Binding IsNotRecorderPage}" Background="{DynamicResource BgBrush}">
            <ContentControl Content="{Binding PageViewModel}">
                <ContentControl.DataTemplates>
                    <DataTemplate DataType="vm:TakesViewModel">
                        <views:TakesView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:PlayerViewModel">
                        <views:PlayerView />
                    </DataTemplate>
                </ContentControl.DataTemplates>
            </ContentControl>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ToastContent}" VerticalAlignment="Bottom"
                            Margin="0,0,0,56" />
        </Grid>

        <!-- Settings sheet -->
        <Grid Grid.RowSpan="4" IsVisible="{Binding IsSettingsOpen}">
            <Border Background="{DynamicResource ScrimBrush}" Tapped="OnScrimTapped" />
            <Border Name="SettingsSheet" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1,0,0,0">
                <Grid RowDefinitions="Auto,*">
                    <Grid ColumnDefinitions="*,Auto" Margin="20,12,12,4">
                        <TextBlock Text="Recording settings" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="icon" Command="{Binding CloseSettingsCommand}" ToolTip.Tip="Close">
                            <c:Icon Data="{StaticResource IconClose}" />
                        </Button>
                    </Grid>
                    <ScrollViewer Grid.Row="1">
                        <StackPanel Margin="20,8,20,28" Spacing="22" IsEnabled="{Binding IsNotRecording}">

                            <StackPanel>
                                <TextBlock Classes="section" Text="FORMAT" />
                                <ListBox Classes="chips" ItemsSource="{Binding FormatOptions}" SelectedItem="{Binding SelectedFormat}" />
                                <TextBlock Classes="muted" Text="{Binding FormatDescription}" TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel IsVisible="{Binding ShowMatroska}">
                                <TextBlock Classes="section" Text="MATROSKA AUDIO CODEC" />
                                <ListBox Classes="chips" ItemsSource="{Binding MatroskaOptions}" SelectedItem="{Binding SelectedMatroska}" />
                                <TextBlock Classes="muted" Text="{Binding SelectedMatroska.Detail}" TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel IsVisible="{Binding ShowAac}">
                                <TextBlock Classes="section" Text="AAC BITRATE PER MIC" />
                                <ListBox Classes="chips" ItemsSource="{Binding AacOptions}" SelectedItem="{Binding SelectedAac}" />
                            </StackPanel>

                            <StackPanel IsVisible="{Binding ShowMp3}">
                                <TextBlock Classes="section" Text="MP3 BITRATE PER MIC" />
                                <ListBox Classes="chips" ItemsSource="{Binding Mp3Options}" SelectedItem="{Binding SelectedMp3}" />
                            </StackPanel>

                            <StackPanel IsVisible="{Binding IsVideoMode}" Spacing="22">
                                <StackPanel>
                                    <TextBlock Classes="section" Text="VIDEO RESOLUTION" />
                                    <ListBox Classes="chips" ItemsSource="{Binding ResolutionOptions}" SelectedItem="{Binding SelectedResolution}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Classes="section" Text="FRAME RATE (FPS)" />
                                    <ListBox Classes="chips" ItemsSource="{Binding FpsOptions}" SelectedItem="{Binding SelectedFps}" />
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="section" Text="VIDEO BITRATE" Margin="0" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{Binding BitRateText}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <TextBlock Classes="muted" Text="Auto" VerticalAlignment="Center" />
                                            <ToggleSwitch IsChecked="{Binding AutoBitRate}" OnContent="" OffContent="" MinWidth="0" />
                                        </StackPanel>
                                    </Grid>
                                    <Slider Minimum="2" Maximum="60" Value="{Binding BitRateMbps}" IsVisible="{Binding !AutoBitRate}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Classes="section" Text="MIC BUTTONS" Margin="0" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <TextBlock Text="Mic buttons start and stop recording" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding MicButtonsControlRecording}" OnContent="" OffContent="" MinWidth="0" />
                                </Grid>
                                <TextBlock Classes="muted" TextWrapping="Wrap"
                                           Text="One press of the button on a SmartMike records all mics; press again to stop." />
                            </StackPanel>

                            <StackPanel IsVisible="{Binding CanChangeRecordingRoot}" Spacing="8">
                                <TextBlock Classes="section" Text="RECORDING FOLDER" Margin="0" />
                                <TextBox Text="{Binding RecordingRoot}" MinHeight="44" VerticalContentAlignment="Center" />
                                <Button Classes="tool" Command="{Binding OpenRecordingsFolderCommand}" HorizontalAlignment="Left"
                                        IsVisible="{Binding CanOpenFolder}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <c:Icon Data="{StaticResource IconFolder}" />
                                        <TextBlock Text="Open folder" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Classes="section" Text="FREE SPACE" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding FreeSpaceText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Classes="muted" TextWrapping="Wrap"
                                           Text="Estimated for the current format, video settings and number of mics." />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Add-mic sheet: microphones of this device; each one becomes its own stream -->
        <Grid Grid.RowSpan="4" IsVisible="{Binding IsAddMicOpen}">
            <Border Background="{DynamicResource ScrimBrush}" Tapped="OnAddMicScrimTapped" />
            <Border Name="AddMicSheet" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1,0,0,0">
                <Grid RowDefinitions="Auto,*">
                    <Grid ColumnDefinitions="*,Auto" Margin="20,12,12,4">
                        <TextBlock Text="Add a microphone" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="icon" Command="{Binding CloseAddMicCommand}" ToolTip.Tip="Close">
                            <c:Icon Data="{StaticResource IconClose}" />
                        </Button>
                    </Grid>
                    <ScrollViewer Grid.Row="1">
                        <StackPanel Margin="20,8,20,28" Spacing="10">
                            <TextBlock Classes="muted" TextWrapping="Wrap"
                                       Text="Each microphone records to its own track, next to your SmartMikes. Add as many as this device can capture at once." />
                            <TextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding !HasAvailableInputs}"
                                       Text="No other microphones found. Connect a USB or Bluetooth headset and try again." />
                            <ItemsControl ItemsSource="{Binding AvailableInputs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="p:AudioInputDevice">
                                        <Button Classes="tool" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                MinHeight="52" Margin="0,3"
                                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).AddInputCommand}"
                                                CommandParameter="{Binding}">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                <Border Classes="avatar" Width="36" Height="36" CornerRadius="12">
                                                    <c:Icon Data="{StaticResource IconMic}" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                                                           TextWrapping="Wrap" />
                                                <c:Icon Grid.Column="2" Data="{StaticResource IconAdd}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Devices sheet: find other Plural apps and control them; make this one findable -->
        <Grid Grid.RowSpan="4" IsVisible="{Binding IsDevicesOpen}">
            <Border Background="{DynamicResource ScrimBrush}" Tapped="OnDevicesScrimTapped" />
            <Border Name="DevicesSheet" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1,0,0,0">
                <Grid RowDefinitions="Auto,*">
                    <Grid ColumnDefinitions="*,Auto" Margin="20,12,12,4">
                        <TextBlock Text="Record with other devices" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="icon" Command="{Binding CloseDevicesCommand}" ToolTip.Tip="Close">
                            <c:Icon Data="{StaticResource IconClose}" />
                        </Button>
                    </Grid>
                    <ScrollViewer Grid.Row="1">
                        <StackPanel Margin="20,8,20,28" Spacing="20">
                            <TextBlock Classes="muted" TextWrapping="Wrap"
                                       Text="Control Plural on other phones and computers: they record their own mics and camera when you press Record here, and send the files back when you stop, into one take." />

                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="section" Text="NEARBY DEVICES" Margin="0" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Classes="tool" Command="{Binding SearchCommand}" IsEnabled="{Binding !IsSearching}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <c:Icon Classes="spinner" Classes.spin="{Binding IsSearching}" Data="{StaticResource IconRefresh}" />
                                            <TextBlock Text="Search" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock Classes="muted" Text="{Binding SearchStatus}" TextWrapping="Wrap"
                                           IsVisible="{Binding SearchStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                <ItemsControl ItemsSource="{Binding FoundPeers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PeerViewModel">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" MinHeight="56" Margin="0,3">
                                                <Border Classes="avatar" Width="40" Height="40" CornerRadius="12">
                                                    <c:Icon Data="{StaticResource IconDevices}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Classes="muted" Text="{Binding Detail}" />
                                                </StackPanel>
                                                <Button Grid.Column="2" Classes="primary" Content="Control" Command="{Binding ConnectCommand}"
                                                        IsVisible="{Binding !IsAdded}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Classes="muted" Text="Added" IsVisible="{Binding IsAdded}" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Spacing="8">
                                <TextBlock Classes="section" Text="THIS DEVICE" Margin="0" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Let other devices control this one" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding AllowRemoteControl}" OnContent="" OffContent="" MinWidth="0" />
                                </Grid>
                                <TextBlock Classes="muted" Text="{Binding FindableText}" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Approval: another device asks to control this one -->
        <Grid Grid.RowSpan="4" IsVisible="{Binding IsApprovalOpen}">
            <Border Background="{DynamicResource ScrimBrush}" />
            <Border Classes="panel" Background="{DynamicResource SurfaceBrush}" MaxWidth="420" Margin="24" Padding="22"
                    HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 10 40 0 #66000000">
                <StackPanel Spacing="16">
                    <c:Icon Data="{StaticResource IconDevices}" Size="36" HorizontalAlignment="Left" Fill="{DynamicResource AccentBrush}" />
                    <TextBlock Text="Allow remote control?" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="{Binding ApprovalText}" TextWrapping="Wrap" />
                    <CheckBox IsChecked="{Binding ApprovalRemember}" Content="Always allow this device" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Classes="tool" Content="Don't allow" Command="{Binding DenyControllerCommand}" />
                        <Button Classes="primary" Content="Allow" Command="{Binding AllowControllerCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- About sheet -->
        <Grid Grid.RowSpan="4" IsVisible="{Binding IsAboutOpen}">
            <Border Background="{DynamicResource ScrimBrush}" Tapped="OnAboutScrimTapped" />
            <Border Name="AboutSheet" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1,0,0,0">
                <Grid RowDefinitions="Auto,*">
                    <Grid ColumnDefinitions="*,Auto" Margin="20,12,12,4">
                        <TextBlock Text="About" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="icon" Command="{Binding CloseAboutCommand}" ToolTip.Tip="Close">
                            <c:Icon Data="{StaticResource IconClose}" />
                        </Button>
                    </Grid>
                    <ScrollViewer Grid.Row="1">
                        <StackPanel Margin="20,8,20,28" Spacing="22">
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <Border Width="64" Height="64" CornerRadius="18" Background="{DynamicResource AccentBrush}">
                                    <c:Icon Data="{StaticResource IconWave}" Size="34" Fill="White" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Plural" FontSize="28" FontWeight="Bold" />
                                    <TextBlock Classes="muted" Text="{Binding AppVersionText}" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock TextWrapping="Wrap"
                                       Text="Record every mic at once: Sabinetek SmartMike+ wireless mics, the microphones of this device, and other phones and computers running Plural, each on its own track." />

                            <Button Classes="tool" Command="{Binding OpenWebsiteCommand}" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <c:Icon Data="{StaticResource IconOpen}" />
                                    <TextBlock Text="getplural.net" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <StackPanel Spacing="6">
                                <TextBlock Classes="section" Text="THIS DEVICE" Margin="0" />
                                <TextBlock Text="{Binding ThisDeviceName}" />
                                <TextBlock Classes="muted" Text="{Binding PlatformText}" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Classes="section" Text="OPEN SOURCE" Margin="0" />
                                <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding CreditsText}" />
                            </StackPanel>

                            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                                       Text="Plural is not affiliated with Sabinetek. SmartMike is a trademark of its owner." />
                            <TextBlock Classes="muted" FontSize="12" Text="{Binding CopyrightText}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Menu sheet (from the header's ⋮ button), laid out like the Takes sheet -->
        <Grid Grid.RowSpan="4" IsVisible="{Binding IsMenuOpen}">
            <Border Background="{DynamicResource ScrimBrush}" Tapped="OnMenuScrimTapped" />
            <Border Name="MenuSheet" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1,0,0,0">
                <Grid RowDefinitions="Auto,*">
                    <Grid ColumnDefinitions="*,Auto" Margin="20,12,12,4">
                        <TextBlock Text="Menu" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="icon" Command="{Binding CloseMenuCommand}" ToolTip.Tip="Close">
                            <c:Icon Data="{StaticResource IconClose}" />
                        </Button>
                    </Grid>
                    <ScrollViewer Grid.Row="1">
                        <StackPanel Margin="20,8,20,28" Spacing="20">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="section" Text="MICS" Margin="0" />
                                <Button Classes="tool menuitem" Command="{Binding RunMenuItemCommand}" CommandParameter="{Binding ConnectAllCommand}">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                        <Border Classes="avatar" Width="40" Height="40" CornerRadius="12">
                                            <c:Icon Data="{StaticResource IconLink}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="Connect all mics" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Classes="muted" Text="Connect every SmartMike and microphone in the list" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Button Classes="tool menuitem" Command="{Binding RunMenuItemCommand}" CommandParameter="{Binding ScanCommand}" IsEnabled="{Binding !IsScanning}">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                        <Border Classes="avatar" Width="40" Height="40" CornerRadius="12">
                                            <c:Icon Data="{StaticResource IconRefresh}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="Scan for paired mics" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Classes="muted" Text="Find SmartMikes paired in your system's Bluetooth settings" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Button Classes="tool menuitem" Command="{Binding RunMenuItemCommand}" CommandParameter="{Binding OpenAddMicCommand}" IsVisible="{Binding CanAddMics}">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                        <Border Classes="avatar" Width="40" Height="40" CornerRadius="12">
                                            <c:Icon Data="{StaticResource IconAdd}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="Add a microphone" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Classes="muted" Text="Use a microphone of this device as its own track" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Classes="section" Text="RECORDING" Margin="0" />
                                <Button Classes="tool menuitem" Command="{Binding RunMenuItemCommand}" CommandParameter="{Binding OpenDevicesCommand}" IsVisible="{Binding CanUseRemote}">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                        <Border Classes="avatar" Width="40" Height="40" CornerRadius="12">
                                            <c:Icon Data="{StaticResource IconDevices}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="Record with other devices" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Classes="muted" Text="Control Plural on other phones and computers" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Button Classes="tool menuitem" Command="{Binding RunMenuItemCommand}" CommandParameter="{Binding OpenSettingsCommand}">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                        <Border Classes="avatar" Width="40" Height="40" CornerRadius="12">
                                            <c:Icon Data="{StaticResource IconTune}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="Recording settings" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Classes="muted" Text="Format, quality, video and folder" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Classes="section" Text="PLURAL" Margin="0" />
                                <Button Classes="tool menuitem" Command="{Binding RunMenuItemCommand}" CommandParameter="{Binding OpenAboutCommand}">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                        <Border Classes="avatar" Width="40" Height="40" CornerRadius="12">
                                            <c:Icon Data="{StaticResource IconInfo}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="About Plural" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Classes="muted" Text="Version, this device and open-source credits" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

    </Grid>
    </ThemeVariantScope>
</UserControl>
