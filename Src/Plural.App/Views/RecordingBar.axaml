<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Plural.App.ViewModels"
             x:Class="Plural.App.Views.RecordingBar"
             x:DataType="vm:MainViewModel">
    <!-- Slim bar at the top of the Takes and Player pages while a take is recording: "● REC 12:34 · Stop" -->
    <Border Background="#33FF4D5E" BorderBrush="{DynamicResource RecordBrush}" BorderThickness="0,0,0,1"
            IsVisible="{Binding IsRecordingUi}" Padding="16,4,8,4">
        <Grid ColumnDefinitions="*,Auto" MinHeight="44">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Ellipse Classes="blink" Width="10" Height="10" Fill="{DynamicResource RecordBrush}" VerticalAlignment="Center" />
                <TextBlock Text="REC" FontWeight="Bold" Foreground="{DynamicResource RecordBrush}" VerticalAlignment="Center" />
                <TextBlock Classes="mono" Text="{Binding RecordingTime}" VerticalAlignment="Center" />
                <TextBlock Classes="muted" Text="Recording continues" VerticalAlignment="Center" />
            </StackPanel>
            <Button Grid.Column="1" Classes="tool" Command="{Binding ToggleRecordingCommand}" IsEnabled="{Binding CanRecord}"
                    ToolTip.Tip="Stop recording">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Width="12" Height="12" CornerRadius="3" Background="{DynamicResource RecordBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="Stop" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</UserControl>
